{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "notification:default",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "url": "^https://" }]
    }
  ]
}
